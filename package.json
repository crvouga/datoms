{
  "name": "datoms",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check": "bun format && bun typecheck && bun lint && bun cir-deps && bun test --bail && echo '✅ All checks passed'",
    "typecheck": "tsc --noEmit",
    "cir-deps": "madge --circular src/index.ts",
    "tc": "bun typecheck -- --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "prepublishOnly": "npm run build",
    "docker": "bun docker:down && bun docker:up",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "docker:destroy": "docker-compose down -v",
    "psql": "docker-compose exec postgres psql -U datoms -d datoms_test",
    "cloc": "bun x cloc src"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@types/bun": "latest",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "madge": "^8.0.0",
    "pg": "^8.11.3",
    "prettier": "^3.0.0",
    "semantic-release": "^23.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
