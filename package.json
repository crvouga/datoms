{
  "name": "datoms",
  "version": "0.1.0",
  "private": true,
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "bun run check:fast && bun test:e2e && echo '✅ All checks passed'",
    "check:fast": "bun format && bun typecheck && bun lint && bun cir-deps && bun test --bail && echo '✅ All fast checks passed'",
    "cir-deps": "madge --circular src/index.ts",
    "cloc": "bun x cloc src",
    "docker": "bun docker:down && bun docker:up && bun moviefinderapp:docker",
    "docker:destroy": "docker-compose down -v",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "docker:up": "docker-compose up -d",
    "format": "bun x sort-package-json && prettier --write \"**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "kp": "bun x kill-port 8080",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "moviefinderapp:docker": "bun moviefinderapp:docker:down && bun moviefinderapp:docker:up",
    "moviefinderapp:docker:down": "cd src/app && docker-compose down",
    "moviefinderapp:docker:up": "cd src/app && docker-compose up -d",
    "prepublishOnly": "npm run build",
    "preview": "docker build --no-cache -t datoms-preview -f Dockerfile . && docker run --name datoms-preview --rm --env-file .env -p 8080:8080 datoms-preview",
    "psql": "psql postgresql://postgres:postgres@localhost:5433/postgres",
    "server": "bun --watch src/app/src/server.ts",
    "tc": "bun typecheck -- --watch",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/standalone": "^7.25.0",
    "@electric-sql/pglite": "^0.2.0",
    "@monaco-editor/react": "^4.6.0",
    "bun-plugin-tailwind": "^0.1.2",
    "pg": "^8.11.3",
    "pino": "^9.0.0",
    "react": "^19",
    "react-dom": "^19",
    "react-resizable-panels": "^2.1.0",
    "sql-formatter": "^15.1.2",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@types/bun": "latest",
    "@types/pg": "^8.10.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "madge": "^8.0.0",
    "playwright": "^1.48.0",
    "prettier": "^3.0.0",
    "semantic-release": "^23.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
