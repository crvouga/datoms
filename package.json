{
  "name": "datoms",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check": "bun format && bun typecheck && bun lint && bun cir-deps && bun test --bail && echo '✅ All checks passed'",
    "typecheck": "tsc --noEmit",
    "cir-deps": "madge --circular src/index.ts",
    "tc": "bun typecheck -- --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "prepublishOnly": "npm run build",
    "docker": "bun docker:down && bun docker:up",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "docker:destroy": "docker-compose down -v",
    "psql": "docker-compose exec postgres psql -U datoms -d datoms_test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@types/bun": "latest",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "madge": "^8.0.0",
    "pg": "^8.11.3",
    "prettier": "^3.0.0",
    "semantic-release": "^23.0.0",
    "typescript": "^5.3.0"
  }
}
